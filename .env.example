# 此文件是环境变量模板；应用仅读取启动进程的环境变量，不会自动加载 .env 文件。
# 本地可由 shell、服务管理器或容器注入这些值。不要提交真实密钥。

NODE_ENV=development
PORT=3000
FRONTEND_PORT=3001
SERVE_FRONTEND=false

# JWT：生产环境必须至少 32 个字符，且不能使用下面的占位符。
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# 私聊 AES-256-GCM 密钥：64 位 hex，或至少 32 UTF-8 字节的高强度字符串。
# 生产环境必填。生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DM_ENCRYPTION_KEY=

# 管理员首次初始化。部署时务必显式设置强密码，不能依赖代码的本地开发回退凭据。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-local-admin-password
# JCHAT_ADMIN_CREDENTIALS_FILE=server/data/admin_credentials.json

# SQLite 数据库。
# JCHAT_DB_FILE=server/data/jchat.sqlite

# CORS 与代理：生产环境请写精确的、逗号分隔的 HTTPS 来源，例如 https://chat.example.com
# JCHAT_ALLOWED_ORIGINS=https://chat.example.com
# 位于受信任反向代理后才设置；可为 true 或 Express trust-proxy 值。
# JCHAT_TRUST_PROXY=true

# HTTP 请求体限制（代码默认分别为 1mb、100kb、1000）。
# JCHAT_JSON_LIMIT=1mb
# JCHAT_URLENCODED_LIMIT=100kb
# JCHAT_URLENCODED_PARAMETER_LIMIT=1000

# 限流：所有值为每个 IP 在窗口内允许的请求数；窗口默认 900000 ms（15 分钟）。
# JCHAT_RATE_LIMIT_WINDOW_MS=900000
# JCHAT_AUTH_RATE_LIMIT_MAX=10
# JCHAT_REGISTRATION_RATE_LIMIT_MAX=20
# JCHAT_ADMIN_RATE_LIMIT_MAX=5
# JCHAT_UPLOAD_RATE_LIMIT_MAX=30

# Socket.IO 限制与心跳（代码默认 1000000、20000、20000、25000，单位均为 ms，首项为字节）。
# JCHAT_SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
# JCHAT_SOCKET_CONNECT_TIMEOUT_MS=20000
# JCHAT_SOCKET_PING_TIMEOUT_MS=20000
# JCHAT_SOCKET_PING_INTERVAL_MS=25000

# 日志：默认 server/logs、保留 30 天，且不记录聊天正文。
# JCHAT_LOG_DIR=server/logs
# JCHAT_LOG_RETENTION_DAYS=30
# JCHAT_LOG_CHAT_CONTENT=false
