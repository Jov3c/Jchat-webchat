# 复制本文件为 .env（同目录）并填写后运行：docker compose up -d --build
# 生成随机串示例：
#   JWT_SECRET：openssl rand -base64 40 | tr -dc 'A-Za-z0-9' | head -c 48
#   DM_ENCRYPTION_KEY：openssl rand -hex 32

# 浏览器访问的域名（公网：如 chat.example.com；局域网：填服务器/电脑 IP）
CADDY_DOMAIN=chat.example.com

# 生产密钥（至少 32 位随机串）
JWT_SECRET=请粘贴48位以上随机串
# 私聊加密密钥（64 位 hex）
DM_ENCRYPTION_KEY=请粘贴64位hex
# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置至少12位强密码
# 浏览器实际访问来源，需与 Caddy 域名一致（如 https://chat.example.com 或 https://192.168.1.5）
JCHAT_ALLOWED_ORIGINS=https://chat.example.com
