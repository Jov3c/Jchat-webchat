{
  "name": "jchat",
  "version": "2.2.0",
  "description": "A lightweight real-time chat application built with Node.js, Socket.IO and SQLite.",
  "main": "index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/*.test.js",
    "dev": "nodemon index.js",
    "reset-data": "node scripts/reset-data.js",
    "frontend": "cd scripts && node frontend-server.js",
    "dev-frontend": "cd scripts && nodemon frontend-server.js",
    "start-all": "concurrently \"node index.js\" \"cd scripts && node frontend-server.js\""
  },
  "keywords": [
    "chat",
    "lan",
    "socket.io",
    "express",
    "responsive"
  ],
  "author": "Jov3c",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jov3c/Jchat.git"
  },
  "bugs": {
    "url": "https://github.com/Jov3c/Jchat/issues"
  },
  "homepage": "https://github.com/Jov3c/Jchat#readme",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-http-proxy": "^2.1.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
